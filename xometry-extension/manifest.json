{
  "manifest_version": 3,
  "name": "Xometry Tools",
  "version": "0.7.0",
  "description": "Helper tools for the Xometry VQC team in Salesforce and QC Center: ERP cards, highlights, partner rating, quick text and more.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "declarativeNetRequestWithHostAccess"
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "erp-graphql-origin", "enabled": true, "path": "src/rules/erp-graphql-origin.json" }
    ]
  },
  "host_permissions": [
    "https://api.xometry.com/*",
    "https://www.xometry.com/api/*",
    "https://www.xometry.com/graphql/*"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "optional_host_permissions": [
    "https://*.my.salesforce.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Xometry Tools",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/popup/popup.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.lightning.force.com/*"
      ],
      "js": [
        "src/common/registry.js",
        "src/common/settings.js",
        "src/common/storage-cache.js",
        "src/common/erp-client.js",
        "src/common/sf-case-history.js",
        "src/common/watchlist.js",
        "src/common/highlight-rules.js",
        "src/common/quick-text-buttons.js",
        "src/common/sf-dom.js",
        "src/common/partner-rating.js",
        "src/content/text-highlighter.js",
        "src/content/partner-rating.js",
        "src/content/auto-refresh.js",
        "src/content/salesforce-erp-sidebar.js",
        "src/content/salesforce-case-erp-button.js",
        "src/content/salesforce-case-info-panel.js",
        "src/content/salesforce-case-cc-check.js",
        "src/content/salesforce-case-quick-text.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.xometry.com/qc-center-app/*"
      ],
      "js": [
        "src/common/registry.js",
        "src/common/settings.js",
        "src/common/highlight-rules.js",
        "src/content/text-highlighter.js",
        "src/content/qcc-quick-verdict.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
